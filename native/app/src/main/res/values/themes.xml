<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FinanceNative" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <!-- The "Send to Mac" tile's window: no visuals, no animation. -->
    <style name="Theme.FinanceNative.Invisible" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
