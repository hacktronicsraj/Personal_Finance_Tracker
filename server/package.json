{
  "name": "pft-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute pft --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute pft --remote --file=./schema.sql",
    "test": "vitest run",
    "smoke": "bash ./scripts/smoke.sh"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^3.99.0"
  }
}
